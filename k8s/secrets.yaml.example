apiVersion: v1
kind: Secret
metadata:
  name: uamichat-secrets
  namespace: uamichat
type: Opaque
data:
  # Generate real values on the server, e.g.:
  #   echo -n "postgresql://uami:YOUR_PASSWORD@postgres:5432/uamichat" | base64
  #   echo -n "YOUR_PASSWORD" | base64
  DB_URL: <base64 encoded connection string>
  DB_PASSWORD: <base64 encoded password>
